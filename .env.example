# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://venturepilot:venturepilot@localhost:5432/venturepilot
# No PostgreSQL handy? Run locally against SQLite (schema is created by
# `alembic upgrade head` or the tests):
# DATABASE_URL=sqlite:///./dev.db

# CORS origins the API accepts. "*" is the dev default; list explicit
# origins (e.g. http://localhost:3000) before shipping.
CORS_ORIGINS=*

# Optional: activates the real Gemini provider. When absent, the app runs the
# deterministic development fallback (labeled "Development mode"). Do not commit a real key.
GEMINI_API_KEY=
